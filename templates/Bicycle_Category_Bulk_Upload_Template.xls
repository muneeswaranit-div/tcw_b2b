    <Cell ss:StyleID="DataCell"><Data ss:Type="String">CHARGER</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cycle World 36V 2A Smart Lithium Battery Charger</Data></Cell>
