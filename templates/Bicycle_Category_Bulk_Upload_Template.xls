   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">TRI CYCLES</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Kids</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cycle World JoyRide Deluxe Kids Tricycle (Pink)</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="Number">20</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="Number">1899</Data></Cell>
