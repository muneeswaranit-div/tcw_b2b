    <Cell ss:StyleID="DataCell"><Data ss:Type="String">HELMET</Data></Cell>
    <Cell ss:StyleID="DataCell"><Data ss:Type="String">Cycle World AeroPro Cycling Helmet (Matte Black)</Data></Cell>
